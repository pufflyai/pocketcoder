{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/ci/*.ts",
        "deploy/image/echo-harness.ts",
        "examples/resume/extension.ts",
        "examples/resume/daemon.ts",
        "examples/**/*.test.ts"
      ]
    },
    ".pstdio/extensions/*": {
      "entry": ["src/view.ts", "**/*.test.ts"]
    },
    "packages/server": {
      "entry": ["src/**/*.test.ts"]
    },
    "packages/remote": {
      "entry": ["src/**/*.test.ts"]
    },
    "examples/harnesses/*": {
      "entry": ["agentapi-compat.ts", "gateway.ts", "*.test.ts"]
    },
    "examples/harnesses/oss": {
      "entry": ["*.test.ts"],
      // Loaded dynamically by OpenCode from OPENCODE_CONFIG_CONTENT.
      "ignoreDependencies": ["@ai-sdk/openai-compatible", "@openai/codex", "opencode-ai"]
    }
  }
}
