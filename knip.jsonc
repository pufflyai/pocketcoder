{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "deploy/image/echo-harness.ts",
        "deploy/image/desktop-harness.ts",
        "examples/resume/extension.ts",
        "examples/resume/daemon.ts",
        "examples/**/*.test.ts"
      ],
      // Lerna invokes Nx internally for task hashing and caching.
      "ignoreDependencies": ["nx"]
    },
    ".pstdio/extensions/*": {
      "entry": ["src/view.ts", "**/*.test.ts"]
    },
    "packages/db": {
      "entry": ["src/database/crash-fixture.ts", "src/migrations/crash-fixture.ts", "src/backup/memory-fixture.ts"]
    },
    "packages/server": {
      "entry": [
        "src/**/*.test.ts",
        "src/persistence/checkpoint-transfer-crash-fixture.ts",
        "src/displays/client/desktop-viewer.ts"
      ]
    },
    "packages/remote": {
      "entry": ["src/**/*.test.ts"]
    },
    "examples/harnesses/*": {
      "entry": ["agentapi-compat.ts", "gateway.ts", "*.test.ts"]
    },
    "examples/harnesses/oss": {
      "entry": ["*.test.ts"],
      // Loaded dynamically by OpenCode from OPENCODE_CONFIG_CONTENT.
      "ignoreDependencies": ["@ai-sdk/openai-compatible", "@openai/codex", "opencode-ai"]
    }
  }
}
