{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "deploy/image/echo-harness.ts",
        "examples/resume/extension.ts",
        "examples/resume/daemon.ts",
        "examples/**/*.test.ts"
      ],
      // Lerna invokes Nx internally for task hashing and caching.
      "ignoreDependencies": ["nx"]
    },
    ".pstdio/extensions/*": {
      "entry": ["**/*.test.ts"]
    },
    "packages/db": {
      "entry": ["src/database/crash-fixture.ts", "src/migrations/crash-fixture.ts"]
    },
    "packages/server": {
      "entry": ["src/**/*.test.ts", "src/persistence/checkpoint-transfer-crash-fixture.ts"]
    },
    "packages/remote": {
      "entry": ["src/**/*.test.ts"]
    },
    "examples/harnesses/*": {
      "entry": ["agentapi-compat.ts", "gateway.ts", "*.test.ts"]
    },
    "examples/harnesses/oss": {
      "entry": ["*.test.ts"],
      // Loaded dynamically by OpenCode from OPENCODE_CONFIG_CONTENT.
      "ignoreDependencies": ["@ai-sdk/openai-compatible", "@openai/codex", "opencode-ai"]
    }
  }
}
