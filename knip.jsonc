{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/ci/*.ts",
        "scripts/pstdio-demo.ts",
        "scripts/build-managed-contract.ts",
        "deploy/image/quiesce.ts",
        "deploy/image/write-session-image.ts",
        "examples/native/artifact-memory-fixture.ts",
        "examples/native/session-fixture.ts",
        "examples/clients/managed-runtime/run.ts",
        "examples/harnesses/file-agent/adapter.ts",
        "deploy/image/echo-harness.ts",
        "deploy/image/controller-probe.ts",
        "deploy/image/desktop-harness.ts",
        "deploy/image/browser-harness.ts",
        "deploy/digitalocean/production/run-access.ts",
        "scripts/native-startup-runner.ts",
        "scripts/upgrade/seed-previous-release.ts",
        "examples/e2e/managed-interruption-child.ts",
        "examples/e2e/managed-purge-bootstrap-child.ts",
        "examples/e2e/kind-purge-rbac.ts",
        "examples/e2e/kubernetes-shared-probe.ts",
        "examples/**/*.test.ts"
      ]
    },
    ".pstdio/extensions/pocketcoder": { "entry": ["**/*.test.ts", "src/codex-template/*.ts"] },
    ".pstdio/extensions/pocketcoder-workspaces": { "entry": ["**/*.test.ts"] },
    "packages/db": {
      "entry": [
        "src/database/crash-fixture.ts",
        "src/database/seed-sync-fixture.ts",
        "src/migrations/crash-fixture.ts",
        "src/backup/memory-fixture.ts"
      ]
    },
    "packages/server": {
      "entry": [
        "src/**/*.test.ts",
        "src/lifecycle/startup-discovery-fixture.ts",
        "src/attachments/input-crash-worker.ts",
        "src/lifecycle/startup-docker-fixture.ts",
        "src/persistence/checkpoint-transfer-crash-fixture.ts",
        "src/control-channel/ws-purge-race-child.ts",
        "src/backup/off-node-crash-fixture.ts",
        "src/displays/client/desktop-viewer.ts",
        "src/displays/client/browser-viewer.ts"
      ]
    },
    "packages/cli": {
      "entry": ["src/bin.ts", "src/**/*.test.ts"]
    },
    "examples/harnesses/pi": {
      "entry": ["*.test.ts", "gateway.ts", "starter/src/check-pi.ts", "starter/write-workload.ts"]
    },
    "examples/harnesses/onefin": { "entry": ["*.test.ts", "start.ts", "docufin-token.ts"] }
  }
}
