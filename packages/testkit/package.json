{
	"name": "@pstdio/pocketcoder-testkit",
	"version": "0.1.0",
	"private": true,
	"description": "In-memory test utilities for Pocketcoder integrations.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pufflyai/pocketcoder.git",
		"directory": "packages/testkit"
	},
	"files": [
		"src",
		"!src/**/*.test.ts"
	],
	"exports": {
		".": "./src/index.ts"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --project ./tsconfig.json --noEmit"
	},
	"dependencies": {
		"@pstdio/pocketcoder-contracts": "workspace:*",
		"@pstdio/pocketcoder-runtime-core": "workspace:*"
	}
}
