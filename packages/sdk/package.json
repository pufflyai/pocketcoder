{
	"name": "@pstdio/pocketcoder-sdk",
	"nx": {
		"tags": [
			"scope:sdk",
			"type:library"
		]
	},
	"version": "0.2.0",
	"private": false,
	"description": "Runtime-validated TypeScript client for the PocketCoder control plane.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pufflyai/pocketcoder.git",
		"directory": "packages/sdk"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "bun build ./src/index.ts --outfile ./dist/index.js --target node --format esm --external zod && bun ./scripts/build-types.ts",
		"test": "bun test",
		"typecheck": "tsc --project ./tsconfig.json --noEmit"
	},
	"dependencies": {
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@pstdio/pocketcoder-contracts": "workspace:*",
		"@types/bun": "1.3.14",
		"@types/node": "26.1.2",
		"rollup": "4.62.4",
		"rollup-plugin-dts": "6.5.1",
		"typescript": "5.9.3"
	}
}
