{
  "name": "@pstdio/pocketcoder-cli",
  "nx": {
    "tags": [
      "scope:cli",
      "type:app"
    ]
  },
  "version": "0.8.0",
  "private": false,
  "description": "Operator and diagnostics CLI for PocketCoder.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pufflyai/pocketcoder.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "pcd": "dist/bin.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "compile": "bun build ./src/index.ts --compile --minify --format=cjs --outfile ../../out/native/pocketcoder",
    "start": "bun ./src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --project ./tsconfig.json --noEmit"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "yargs": "^17.7.2",
    "@pstdio/pocketcoder-drivers": "workspace:*",
    "@pstdio/pocketcoder-auth": "workspace:*",
    "@pstdio/pocketcoder-contracts": "workspace:*",
    "@pstdio/pocketcoder-db": "workspace:*",
    "@pstdio/pocketcoder-runtime-core": "workspace:*",
    "@pstdio/pocketcoder-sdk": "workspace:*",
    "@pstdio/pocketcoder-server": "workspace:*",
    "@pstdio/pocketcoder-testkit": "workspace:*",
    "@types/yargs": "^17.0.35"
  }
}
