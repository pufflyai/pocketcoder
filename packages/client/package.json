{
	"name": "@pstdio/pocketcoder-client",
	"nx": {
		"tags": [
			"scope:client",
			"type:library"
		]
	},
	"version": "0.2.0",
	"private": false,
	"description": "Runtime-validated TypeScript client for the PocketCoder control plane.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pufflyai/pocketcoder.git",
		"directory": "packages/client"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"bun": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "bun build ./src/index.ts --outdir ./dist --target node --packages external",
		"test": "bun test",
		"typecheck": "tsc --project ./tsconfig.json --noEmit"
	},
	"dependencies": {
		"@pstdio/pocketcoder-contracts": "workspace:*",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"typescript": "5.9.3"
	}
}
