{
  "name": "@pstdio/pocketcoder-remote",
  "nx": {
    "tags": [
      "scope:remote",
      "type:app"
    ]
  },
  "version": "0.3.0",
  "private": false,
  "description": "Pi-based terminal UI for PocketCoder workspaces.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pufflyai/pocketcoder.git",
    "directory": "packages/remote"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "pocketcoder-remote": "dist/bin.js"
  },
  "exports": {
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "start": "bun ./src/bin.ts",
    "test": "bun test",
    "typecheck": "tsc --project ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@pstdio/pocketcoder-sdk": "workspace:^"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "tsdown": "0.22.14",
    "typescript": "5.9.3"
  }
}
