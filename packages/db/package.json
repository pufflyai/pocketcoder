{
	"name": "@pstdio/pocketcoder-db",
	"version": "0.1.0",
	"private": true,
	"description": "PostgreSQL persistence for Pocketcoder.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pufflyai/pocketcoder.git",
		"directory": "packages/db"
	},
	"files": [
		"drizzle",
		"src",
		"!src/**/*.test.ts"
	],
	"exports": {
		".": "./src/index.ts"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"scripts": {
		"db:generate": "bun ./scripts/generate.ts",
		"test": "bun test",
		"typecheck": "tsc --project ./tsconfig.json --noEmit"
	},
	"dependencies": {
		"@pstdio/pocketcoder-contracts": "workspace:*",
		"@pstdio/pocketcoder-runtime-core": "workspace:*",
		"drizzle-orm": "1.0.0-rc.4"
	},
	"devDependencies": {
		"drizzle-kit": "1.0.0-rc.4"
	}
}
