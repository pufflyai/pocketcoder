{
  "name": "@pstdio/pocketcoder-db",
  "nx": {
    "tags": [
      "scope:persistence",
      "type:adapter"
    ]
  },
  "version": "0.1.0",
  "private": true,
  "description": "Embedded PGlite persistence for PocketCoder.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pufflyai/pocketcoder.git",
    "directory": "packages/db"
  },
  "files": [
    "assets",
    "drizzle",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/test-fixtures.ts",
    "./checkpoints": "./src/checkpoints.ts",
    "./backup": "./src/backup.ts"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "test": "bun test",
    "typecheck": "tsc --project ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@pstdio/pocketcoder-contracts": "workspace:*",
    "@pstdio/pocketcoder-runtime-contracts": "workspace:*",
    "@pstdio/pocketcoder-runtime-core": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@pstdio/pocketcoder-testkit": "workspace:*",
    "drizzle-kit": "1.0.0-rc.4"
  }
}
