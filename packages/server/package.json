{
  "name": "@pstdio/pocketcoder-server",
  "nx": {
    "tags": [
      "scope:control-plane",
      "type:app"
    ]
  },
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./config": "./src/config/config.ts",
    "./lifecycle": "./src/lifecycle/lifecycle.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "compile": "bun build ./src/index.ts --compile --outfile ./dist/pocketcoder-server",
    "dev": "bun --watch ./src/index.ts",
    "start": "bun ./src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --project ./tsconfig.json --noEmit && tsc --project ./src/displays/client/tsconfig.json"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.1.0",
    "@pstdio/pocketcoder-auth": "workspace:*",
    "@pstdio/pocketcoder-contracts": "workspace:*",
    "@pstdio/pocketcoder-db": "workspace:*",
    "@pstdio/pocketcoder-drivers": "workspace:*",
    "@pstdio/pocketcoder-runtime-core": "workspace:*",
    "hono": "^4.8.0",
    "tldts-core": "7.4.18",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@novnc/novnc": "1.7.0",
    "@pstdio/pocketcoder-sdk": "workspace:*",
    "@pstdio/pocketcoder-supervisor": "workspace:*",
    "@pstdio/pocketcoder-testkit": "workspace:*",
    "tldts": "7.4.18"
  }
}
