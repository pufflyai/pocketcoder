{
	"name": "@pocketcoder/agent",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun build ./src/index.ts --outdir ./dist --target bun",
		"compile": "bun build ./src/index.ts --compile --outfile ./dist/pocketcoder-agent",
		"start": "bun ./src/index.ts",
		"typecheck": "tsc --project ./tsconfig.json --noEmit"
	},
	"dependencies": {
		"@pocketcoder/contracts": "workspace:*"
	}
}
