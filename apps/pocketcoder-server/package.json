{
	"name": "@pstdio/pocketcoder-server",
	"nx": {
		"tags": [
			"scope:control-plane",
			"type:app"
		]
	},
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/app.ts",
		"./config": "./src/config.ts",
		"./lifecycle": "./src/lifecycle.ts"
	},
	"scripts": {
		"build": "bun build ./src/index.ts --outdir ./dist --target bun",
		"compile": "bun build ./src/index.ts --compile --outfile ./dist/pocketcoder-server",
		"dev": "bun --watch ./src/index.ts",
		"start": "bun ./src/index.ts",
		"test": "bun test",
		"typecheck": "tsc --project ./tsconfig.json --noEmit"
	},
	"dependencies": {
		"@pstdio/pocketcoder-auth": "workspace:*",
		"@pstdio/pocketcoder-contracts": "workspace:*",
		"@pstdio/pocketcoder-db": "workspace:*",
		"@pstdio/pocketcoder-drivers": "workspace:*",
		"@pstdio/pocketcoder-memory-store": "workspace:*",
		"@pstdio/pocketcoder-runtime-core": "workspace:*",
		"@hono/zod-openapi": "^1.1.0",
		"hono": "^4.8.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@pstdio/pocketcoder-sdk": "workspace:*",
		"@pstdio/pocketcoder-testkit": "workspace:*"
	}
}
