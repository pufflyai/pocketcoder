# Copy this file to `.env` and replace the placeholders. Never commit a real key.

# Used by pcd workspace and diagnostics commands.
POCKETCODER_URL=http://127.0.0.1:8090
POCKETCODER_KEY=pkt_replace_with_your_machine_key

# Used by local administrative commands, while the server is stopped.
# POCKETCODER_DIR=./pc_data
# POCKETCODER_STORE=pglite
# POCKETCODER_AUTH_PEPPER=replace_with_a_random_secret
# POCKETCODER_STORAGE_BACKEND=filesystem
# POCKETCODER_WORKSPACE_DATA_DIR=/absolute/path/pocketcoder/workspaces
# POCKETCODER_CHECKPOINT_DIR=/absolute/path/pocketcoder/checkpoints
# POCKETCODER_SECRET_PROVIDER=file
# POCKETCODER_SECRET_ROOT=/absolute/path/pocketcoder/secrets

# PostgreSQL replaces the embedded store. Setting a database URL selects it,
# and then the pepper and journal folder are required.
# POCKETCODER_DATABASE_URL=postgres://user:pass@127.0.0.1:5432/pocketcoder
# POCKETCODER_DATABASE_SCHEMA=pocketcoder
# POCKETCODER_JOURNAL_DIR=/absolute/path/pocketcoder/journal

# Used by `bun run example:pi:ui` and `bun run example:e2e:pi:openai`.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=your_openai_model_id_here
