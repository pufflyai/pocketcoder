[Unit]
Description=Capture encrypted PocketCoder account backups
After=pocketcoder-manager.service

[Service]
Type=oneshot
User=pocketcoder-operator
Group=pocketcoder-operator
UMask=0077
WorkingDirectory=/opt/pocketcoder
ExecStart=/usr/local/bin/bun --no-env-file deploy/recovery/run-account-backups.ts /etc/pocketcoder-private/account-backups.json
TimeoutStartSec=1h
NoNewPrivileges=true
