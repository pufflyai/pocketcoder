{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["bun"],
    "paths": {
      "@pstdio/pocketcoder-sdk": ["../../../packages/sdk/src/index.ts"]
    }
  },
  "include": ["extension.ts", "prepare-sdk*.ts", "src/**/*.ts"]
}
