{
  "apiVersion": "pocketcoder.dev/v1alpha1",
  "kind": "Template",
  "metadata": {
    "name": "fixture-echo",
    "description": "Harmless fixture: fake AgentAPI echo harness for conformance tests"
  },
  "spec": {
    "version": "1.0.0",
    "image": "example.registry/fixture-echo@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "harness": {
      "command": ["bun", "/opt/fixtures/echo-agentapi.ts"]
    },
    "resources": { "cpu": "1", "memory": "256Mi" },
    "timeouts": { "start": "1m", "maxAge": "30m", "idle": "10m" },
    "services": {
      "agent": {
        "baseUrl": "http://127.0.0.1:3284",
        "routes": [
          { "method": "GET", "path": "/status" },
          { "method": "GET", "path": "/messages", "query": ["after"] },
          { "method": "POST", "path": "/message" }
        ]
      }
    }
  }
}
