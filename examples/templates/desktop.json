{
  "apiVersion": "pocketcoder.dev/v1alpha1",
  "kind": "Template",
  "metadata": {
    "name": "desktop",
    "description": "Non-root desktop with loopback VNC"
  },
  "spec": {
    "version": "1.0.0",
    "image": "pocketcoder-desktop@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "harness": {
      "command": ["bun", "/opt/pocketcoder/desktop-harness.ts", "bun", "/opt/pocketcoder/controller-probe.ts"]
    },
    "display": {
      "mode": "desktop"
    },
    "env": {
      "DISPLAY": ":99"
    },
    "resources": {
      "cpu": "1",
      "memory": "768Mi"
    },
    "services": {
      "probe": {
        "baseUrl": "http://127.0.0.1:3284",
        "healthPath": "/healthz",
        "routes": [
          {
            "method": "GET",
            "path": "/healthz"
          },
          {
            "method": "POST",
            "path": "/probe"
          }
        ]
      }
    },
    "timeouts": {
      "terminateGrace": "3s"
    }
  }
}
