{
	"apiVersion": "pocketcoder.dev/v1alpha1",
	"kind": "Template",
	"metadata": {
		"name": "pi-harness",
		"description": "Pi CLI integrated through AgentAPI"
	},
	"spec": {
		"version": "1.0.0",
		"image": "example.invalid/pocketcoder-pi@sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
		"setup": [
			{
				"name": "load-test-workspace",
				"command": ["cp", "-R", "/opt/pocketcoder-fixtures/.", "/workspace"],
				"cwd": "/workspace",
				"timeoutSeconds": 30
			}
		],
		"agent": {
			"type": "custom",
			"command": ["/usr/local/bin/run-pi"],
			"cwd": "/workspace",
			"env": {
				"PI_GATEWAY_URL": "http://host.docker.internal:8080/v1",
				"PI_GATEWAY_MODEL": "replace-with-your-model",
				"PI_GATEWAY_PROVIDER": "pocketcoder-gateway",
				"PI_CODING_AGENT_DIR": "/home/agent/.pi/agent",
				"PI_WORKSPACE_DIR": "/workspace"
			}
		},
		"terminal": {
			"command": ["/bin/sh"],
			"cwd": "/workspace",
			"maxSessions": 2,
			"idleTimeout": "10m"
		},
		"env": {
			"HOME": "/home/agent"
		},
		"resources": { "cpu": "2", "memory": "2Gi" },
		"timeouts": {
			"start": "5m",
			"maxAge": "2h",
			"idle": "20m",
			"disconnectGrace": "5m",
			"terminateGrace": "15s"
		},
		"security": {
			"uid": 10001,
			"gid": 10001,
			"readOnlyRoot": true,
			"writableMemoryPaths": ["/tmp", "/home/agent", "/workspace"]
		}
	}
}
